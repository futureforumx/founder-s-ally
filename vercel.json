{
  "crons": [
    {
      "path": "/api/cron/update-leaderboard",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/refresh-domain-ratings",
      "schedule": "15 * * * *"
    }
  ],
  "functions": {
    "api/firm-website-team.ts": {
      "maxDuration": 120
    },
    "api/deck-share-file.ts": {
      "maxDuration": 120
    },
    "api/cron/update-leaderboard.ts": {
      "maxDuration": 60
    }
  },
  "redirects": [
    { "source": "/FRESH-CAPITAL", "destination": "/fresh-capital", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
